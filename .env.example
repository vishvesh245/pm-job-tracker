# ── LinkedIn Auth ─────────────────────────────────────────────────────────────
# Option 1 (Recommended): li_at cookie — stable, avoids captcha
# How to get: Log into LinkedIn in Chrome → DevTools (F12) → Application →
# Cookies → https://www.linkedin.com → find "li_at" → copy its Value
LINKEDIN_LI_AT=

# Option 2: Email + Password (may trigger captcha on new machines)
LINKEDIN_EMAIL=your_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password

# ── Resume ────────────────────────────────────────────────────────────────────
# Absolute path to your CV/resume PDF (used for JD-CV relevance scoring)
LINKEDIN_RESUME_PATH=/Users/yourname/Documents/resume.pdf

# Years of experience shown in outreach messages
LINKEDIN_EXPERIENCE_YEARS=4

# ── AI Scoring (optional) ─────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com
# Used for JD-CV relevance scoring and email/LinkedIn message generation
ANTHROPIC_API_KEY=sk-ant-...

# ── Exports (optional) ────────────────────────────────────────────────────────
# Directory for exported Excel contact files (defaults to ~/Downloads)
CONTACTS_EXPORT_DIR=/Users/yourname/Downloads
