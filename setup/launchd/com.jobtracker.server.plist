<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Auto-start the job tracker server on login and keep it alive.
     1. Replace /Users/YOUR_USERNAME with your actual home directory path.
     2. Copy to ~/Library/LaunchAgents/
     3. Run: launchctl load ~/Library/LaunchAgents/com.jobtracker.server.plist -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jobtracker.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOUR_USERNAME/job-tracker/.venv/bin/python3</string>
        <string>/Users/YOUR_USERNAME/job-tracker/build_report.py</string>
        <string>--serve</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/YOUR_USERNAME/job-tracker</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/YOUR_USERNAME/job-tracker/logs/server.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USERNAME/job-tracker/logs/server-error.log</string>
</dict>
</plist>
